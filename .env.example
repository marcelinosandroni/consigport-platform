# ==============================================================================
# ConsigPort — Variáveis de Ambiente (Template de Configuração Local)
# Copie este arquivo para .env: cp .env.example .env
# NUNCA commite o arquivo .env no repositório!
# ==============================================================================

# --- Banco de Dados PostgreSQL 16 ---
POSTGRES_DB=consigport
POSTGRES_USER=consigport
POSTGRES_PASSWORD=consigport
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://postgres:5432/consigport

# --- Portas dos Módulos ---
BACKEND_PORT=8080
MOCK_PORT=8081
FRONTEND_PORT=5173

# --- Criptografia e Integridade (HMAC-SHA256) ---
# Segredo compartilhado entre ConsigPort Core e o Mock da Central de Convênios
HMAC_SECRET=consigport-secret-key-change-me-in-production

# --- Integração com a Central de Convênios ---
# URL interna acessível via rede do Docker Compose
CENTRAL_BASE_URL=http://central-convenios-mock:8081

# --- Parâmetros de Simulação do Mock Central ---
# Delay em milissegundos para simulação de resposta assíncrona (204 até 200)
MOCK_CONFIRMATION_DELAY_MS=4000
# Atraso injetado nos cenários de teste com sufixo -TIMEOUT
MOCK_TIMEOUT_DELAY_MS=6000

# --- Orquestração do Worker de Polling ---
# Intervalo de consulta de status assíncrono (respeitando Retry-After)
POLLING_INTERVAL_MS=2000
# Tamanho do lote de operações avaliadas por ciclo de polling
POLLING_BATCH_SIZE=20

# --- Frontend Web ---
# URL pública da API do Backend consumida pelo navegador
VITE_API_BASE_URL=http://localhost:8080
